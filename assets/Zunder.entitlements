<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Der Browser selbst läuft in der Sandbox von macOS: Er kommt nur an sein
         eigenes Profil, an den Download-Ordner und an Dateien, die man ihm im
         Dateidialog ausdrücklich gibt – nicht an den Rest des Benutzerordners. -->
    <key>com.apple.security.app-sandbox</key><true/>
    <key>com.apple.security.network.client</key><true/>
    <key>com.apple.security.files.downloads.read-write</key><true/>
    <key>com.apple.security.files.user-selected.read-write</key><true/>
    <key>com.apple.security.print</key><true/>
    <!-- Kamera und Mikrofon: Voraussetzung dafür, dass WebKit je Seite
         nachfragen kann. Von selbst bekommt keine Seite etwas. -->
    <key>com.apple.security.device.camera</key><true/>
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Standort: nur für eingebaute Apps (Wetter) und erst nach Zustimmung je
         App. Webseiten bietet Zunder den Standort nicht an. -->
    <key>com.apple.security.personal-information.location</key><true/>
    <!-- Nur lesen, und nur genau das: das Profil aus der Zeit vor der Sandbox
         (einmal herüberholen) und die Lesezeichen-Dateien anderer Browser
         („Aus Chrome übernehmen“) – nicht deren Cookies oder Passwörter. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/Zunder/</string>
        <string>/Library/Application Support/Google/Chrome/Default/Bookmarks</string>
        <string>/Library/Application Support/BraveSoftware/Brave-Browser/Default/Bookmarks</string>
        <string>/Library/Application Support/Microsoft Edge/Default/Bookmarks</string>
        <string>/Library/Application Support/Vivaldi/Default/Bookmarks</string>
    </array>
</dict>
</plist>
